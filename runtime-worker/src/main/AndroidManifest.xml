<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <permission
        android:name="com.assayflux.pockethost.permission.BIND_RUNTIME_WORKER"
        android:protectionLevel="signature" />
    <queries>
        <package android:name="com.assayflux.pockethost" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="Pocket Host Runtime Worker"
        android:supportsRtl="true">
        <service
            android:name=".RuntimeCellProbeService"
            android:exported="true"
            android:permission="com.assayflux.pockethost.permission.BIND_RUNTIME_WORKER"
            android:isolatedProcess="true"
            android:process=":cell_probe" />
        <service
            android:name=".RuntimeCellProbeServiceTwo"
            android:exported="true"
            android:permission="com.assayflux.pockethost.permission.BIND_RUNTIME_WORKER"
            android:isolatedProcess="true"
            android:process=":cell_probe_2" />
        <service
            android:name=".RuntimeWorkerService"
            android:exported="true"
            android:permission="com.assayflux.pockethost.permission.BIND_RUNTIME_WORKER"
            android:process=":runtime_worker"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started website runtime companion for Python and Node.js" />
        </service>
        <service
            android:name=".NodeHostingService"
            android:exported="false"
            android:process=":node"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started Node.js website runtime in the isolated companion application UID" />
        </service>
    </application>
</manifest>
