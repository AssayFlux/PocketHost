{
    on_demand_tls {
        ask http://control-plane:8080/v1/relay/tls-check
    }
    import /etc/caddy/trusted-proxy.caddy
    servers :443 {
        strict_sni_host on
    }
}

# Dedicated console hostname: static React/Vite app, never the visitor relay.
{$POCKETHOST_CONSOLE_DOMAIN} {
    encode zstd gzip
    reverse_proxy web-console:8080
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
}

# Dedicated management API hostname.
{$CONTROL_PLANE_DOMAIN} {
    encode zstd gzip
    reverse_proxy control-plane:8080 {
        header_up CF-Connecting-IP {client_ip}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
}

:80 {
    redir https://{host}{uri} permanent
}

# All other authorized hostnames are visitor-ingress routes. The control plane
# checks DNS ownership before Caddy is permitted to issue an on-demand cert.
:443 {
    tls {
        on_demand
    }
    encode zstd gzip
    reverse_proxy control-plane:8081 {
        header_up CF-Connecting-IP {client_ip}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
}
