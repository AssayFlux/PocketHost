{
    on_demand_tls {
        ask http://control-plane:8080/v1/relay/tls-check
    }
    servers {
        # Only the exact colocated Cloudflared peer may supply client-IP metadata.
        # Never trust every private/container address on the bridge network.
        trusted_proxies static {$POCKETHOST_CLOUDFLARED_IP:172.31.240.11}/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
    servers :443 {
        strict_sni_host on
    }
}

{$CONTROL_PLANE_DOMAIN} {
    encode zstd gzip
    reverse_proxy control-plane:8080 {
        header_up CF-Connecting-IP {client_ip}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}

:80 {
    redir https://{host}{uri} permanent
}

:443 {
    tls {
        on_demand
    }
    encode zstd gzip
    reverse_proxy control-plane:8081 {
        header_up CF-Connecting-IP {http.request.client_ip}
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
