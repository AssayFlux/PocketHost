# Copy to .env and replace every example value.
CONTROL_PLANE_DOMAIN=api.example.com
POCKETHOST_CONTROL_API_HOST=api.example.com
POCKETHOST_CONSOLE_DOMAIN=console.example.com
# Canonical WebAuthn origin; use the console hostname.
POCKETHOST_CONTROL_ORIGIN=https://console.example.com
# Exact browser origins allowed to call the management API (no wildcard).
POCKETHOST_CONTROL_ORIGINS=https://console.example.com,https://admin.example.com
POCKETHOST_CONTROL_ADMIN_TOKEN=replace-with-at-least-64-random-hex-characters
POSTGRES_DB=pockethost
POSTGRES_USER=pockethost
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Choose an unused Docker bridge subnet if the default overlaps your LAN/VPN.
POCKETHOST_DOCKER_SUBNET=172.31.240.0/24
POCKETHOST_CADDY_IP=172.31.240.10
POCKETHOST_CLOUDFLARED_IP=172.31.240.11
# Exact static peer IPs for the Caddy and cloudflared containers in compose.yaml.
POCKETHOST_TRUSTED_PROXY_IPS=172.31.240.10,172.31.240.11
