# Shared, narrowly scoped Cloudflared peer trust policy.
# Keep this file imported by both production Caddy and the proxy-spoof integration test.
servers {
    trusted_proxies static {$POCKETHOST_CLOUDFLARED_IP:172.31.240.11}/32
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP X-Forwarded-For
}
